generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  careerPlans CareerPlan[]
  skills    Skill[]
}

model Skill {
  id           String   @id @default(uuid())
  name         String
  currentLevel Int
  targetLevel  Int
  userId       String
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model CareerPlan {
  id             String   @id @default(uuid())
  role           String
  jobDescription String
  aiPlan         Json

  userId         String
  user           User     @relation(fields: [userId], references: [id])

  createdAt      DateTime @default(now())
}
